# ==============================================
# EastPark Backend — Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ==============================================
# APPLICATION
# ==============================================
APP_ENV="local"            # local | staging | production
APP_NAME="EastPark API"
APP_LOG_LEVEL="debug"

APP_CORS_ORIGINS="*"      # prod: "https://app.eastpark.com"

# ==============================================
# HTTP SERVER
# ==============================================
HTTP_HOST="0.0.0.0"
HTTP_PORT=3000

# ==============================================
# AUTHENTICATION & JWT
# Two separate secrets required.
# Generate: openssl rand -base64 48
# ==============================================
AUTH_ACCESS_TOKEN_SECRET="change-me-min-32-chars"
AUTH_REFRESH_TOKEN_SECRET="change-me-different-min-32-chars"
AUTH_ACCESS_TOKEN_EXP="15m"
AUTH_REFRESH_TOKEN_EXP="7d"

# Reset-password token TTL (stored in Redis)
AUTH_RESET_TOKEN_TTL_SEC=1800  # 30 minutes

# ==============================================
# DATABASE (PostgreSQL / Neon in prod)
# ==============================================
DATABASE_URL="postgresql://postgres:master123@localhost:5432/eastpark?schema=public"

# ==============================================
# REDIS (Upstash in prod — use rediss:// for TLS)
# ==============================================
REDIS_URL="redis://localhost:6379"

# ==============================================
# EMAIL (Mailpit locally, Brevo SMTP in prod)
# ==============================================
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@eastpark.app"

# ==============================================
# FILE STORAGE
# Dev: MinIO (docker-compose) → S3-compatible
# Prod: Supabase Storage
# ==============================================
SUPABASE_URL="http://localhost:9002"
SUPABASE_SERVICE_KEY="minioadmin"
SUPABASE_BUCKET="eastpark-uploads"

# ==============================================
# EXPO PUSH NOTIFICATIONS
# ==============================================
# Optional — only needed for enhanced Expo Push access
EXPO_ACCESS_TOKEN=""

# ==============================================
# PAYMENTS — PAYMOB
# ==============================================
PAYMOB_API_KEY=""
PAYMOB_HMAC_SECRET=""
PAYMOB_INTEGRATION_ID=""   # From Paymob dashboard → Integrations → Integration ID
PAYMOB_IFRAME_ID=""        # From Paymob dashboard → Integrations → iframe ID

# ==============================================
# APP URL (used for reset-password deep links)
# ==============================================
APP_URL="http://localhost:3000"
